{
  "expo": {
    "name": "School Matrix",
    "slug": "schoolmatrix-mobile",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolmatrix.app",
      "buildNumber": "13",
      "appleTeamId": "P227YQ54ZL",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "34.95.43.132": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false
            },
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F3F1",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.schoolmatrix.app",
      "versionCode": 9,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "./plugins/withAndroidApkInstall",
      "./plugins/withEmbedExpoModulesJSI",
      "expo-file-system",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "School Matrix utilise vos photos pour les fiches élèves et votre photo de profil.",
          "cameraPermission": "School Matrix utilise la caméra pour les fiches élèves et votre photo de profil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#B85A48",
          "defaultChannel": "birthdays"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "c3e243d8-9622-4117-a49a-eba5f3427d0c"
      }
    },
    "owner": "larosemike"
  }
}
