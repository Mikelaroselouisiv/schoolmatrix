# Base de données (même base que Docker : docker compose up -d pour lancer uniquement la base)
DB_HOST=localhost
DB_PORT=5432
DB_USER=schoolmatrix
DB_PASS=schoolmatrix
DB_NAME=schoolmatrix

# JWT (requis)
JWT_SECRET=your-secret-key-change-in-production

# Stockage local (défaut: ./storage)
# STORAGE_ROOT=./storage

# Nœud de synchronisation (LOCAL = vérité, CLOUD = miroir)
# NODE_ID=LOCAL
# SYNC_API_KEY=same-key-on-local-and-cloud

# Google Cloud Storage (optionnel en dev)
# GCS_BUCKET=parallele-schoolmatrix-assets
# GCS_PREFIX=schoolmatrix
# GCS_PROJECT_ID=parallele-schoolmatrix


# NODE_ENV=development utilise .env.dev
