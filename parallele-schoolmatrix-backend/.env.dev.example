# Copier vers .env.dev — utilisé uniquement quand NODE_ENV=development
# Postgres DEV : conteneur schoolmatrix-db-dev (voir dev/docker-compose.postgres.yml)

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5435
DB_USER=schooluser
DB_PASS=schoolpass
DB_NAME=schoolmatrix

# JWT (requis)
JWT_SECRET=your-secret-key-change-in-production

# Stockage local (défaut: ./storage)
# STORAGE_ROOT=./storage

# Sync (optionnel en DEV)
# NODE_ID=LOCAL
# SYNC_API_KEY=same-key-on-local-and-cloud

# Google Cloud Storage (optionnel en DEV)
# GCS_BUCKET=parallele-schoolmatrix-assets
# GCS_PREFIX=schoolmatrix
# GCS_PROJECT_ID=parallele-schoolmatrix
