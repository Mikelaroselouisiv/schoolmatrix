# Backend DEV sur :3001 branché sur le miroir cloud LOCAL (schoolmatrix-db-cloud-dev).
# Copier vers .env.dev.mirror. Ne jamais pointer vers la VM GCP.

NODE_ENV=development
PORT=3001
ENV_FILE=.env.dev.mirror

DB_HOST=localhost
DB_PORT=5438
DB_USER=schooluser
DB_PASS=schoolpass
DB_NAME=schoolmatrix

JWT_SECRET=your-secret-key-change-in-production

STORAGE_ROOT=./storage

NODE_ID=CLOUD
SYNC_API_KEY=parallele-dev-sync-lab
